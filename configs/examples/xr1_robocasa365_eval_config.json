{
    "dataset_mixture": {
        "datasets": [
            {
                "repo_id": "lerobot/droid_100"
            }
        ],
        "weights": [
            1.0
        ],
        "action_freq": 20.0,
        "n_obs_history": 4,
        "history_state_drop_prob": 0.0,
        "image_resample_strategy": "nearest",
        "vector_resample_strategy": "nearest"
    },
    "policy": {
        "type": "xr1",
        "pretrained_path": "XiaomiRobotics/Xiaomi-Robotics-1-RoboCasa365",
        "pretrained_backbone_repo_id": "XiaomiRobotics/Xiaomi-Robotics-1-RoboCasa365",
        "load_pretrained_backbone": true,
        "n_obs_steps": 4,
        "history_interval": 2,
        "input_features": {
            "camera0": {
                "shape": [
                    3,
                    256,
                    256
                ],
                "type": "VISUAL"
            },
            "camera1": {
                "shape": [
                    3,
                    256,
                    256
                ],
                "type": "VISUAL"
            },
            "camera2": {
                "shape": [
                    3,
                    256,
                    256
                ],
                "type": "VISUAL"
            },
            "state": {
                "shape": [
                    16
                ],
                "type": "STATE"
            }
        },
        "output_features": {
            "actions": {
                "shape": [
                    12
                ],
                "type": "ACTION"
            }
        },
        "normalization_mapping": {
            "VISUAL": "IDENTITY",
            "STATE": "IDENTITY",
            "ACTION": "IDENTITY"
        },
        "chunk_size": 16,
        "n_action_steps": 16,
        "max_delay": 0,
        "num_cams": 3,
        "image_size": 256,
        "center_crop_ratio": 0.95,
        "max_state_dim": 16,
        "state_token_dim": 60,
        "max_action_dim": 60,
        "state_adapter": "robocasa_panda_omron",
        "quat_order": "xyzw",
        "num_steps": 5,
        "attention_implementation": "eager",
        "freeze_input_embeddings": true,
        "freeze_vision_encoder": false,
        "train_expert_only": false,
        "gradient_checkpointing": false
    },
    "output_dir": "outputs/xr1_robocasa365_eval",
    "resume": false,
    "seed": 7,
    "resolution": [
        256,
        256
    ],
    "num_cams": 3,
    "max_state_dim": 16,
    "max_action_dim": 60,
    "action_chunk": 16,
    "loss_weighting": {
        "MSE": 1.0,
        "CE": 1.0
    },
    "num_workers": 4,
    "batch_size": 2,
    "gradient_accumulation_steps": 1,
    "dataloader_batch_size": 2,
    "prefetch_factor": 8,
    "steps": 100,
    "log_freq": 1,
    "save_checkpoint": false,
    "save_freq": 100,
    "use_policy_training_preset": true,
    "trace_nans": false,
    "optimizer": {
        "type": "adamw",
        "lr": 3e-05,
        "weight_decay": 0.1,
        "grad_clip_norm": 1.0,
        "betas": [
            0.9,
            0.95
        ],
        "eps": 1e-08
    },
    "env": {
        "type": "robocasa",
        "task": "CloseFridge",
        "fps": 20,
        "max_parallel_tasks": 1,
        "episode_length": null,
        "obs_type": "pixels_agent_pos",
        "render_mode": "rgb_array",
        "camera_name": "robot0_agentview_left,robot0_agentview_right,robot0_eye_in_hand",
        "observation_height": 256,
        "observation_width": 256,
        "visualization_height": 512,
        "visualization_width": 512,
        "split": "pretrain",
        "obj_registries": [
            "objaverse",
            "lightwheel"
        ],
        "metadata": {
            "robot_type": "PandaOmron",
            "control_mode": "ee"
        }
    },
    "eval": {
        "n_episodes": 10,
        "batch_size": 2,
        "use_async_envs": true,
        "max_episodes_rendered": 4,
        "grid_size": null,
        "seed": 7,
        "seed_list": null,
        "control_mode": "ee"
    },
    "scheduler": {
        "type": "cosine_decay_with_warmup",
        "num_warmup_steps": 500,
        "num_decay_steps": 120000,
        "peak_lr": 3e-05,
        "decay_lr": 3e-06
    },
    "wandb": {
        "enable": false,
        "entity": "wyautox-autox",
        "project": "xr1",
        "run_id": null,
        "name": null,
        "notes": "Xiaomi-Robotics-1 RoboCasa365 eval-parity ladder. Three settings are load-bearing for reproducing the published per-task rates. (1) Camera order: agentview_left, agentview_right, eye_in_hand -- WRIST LAST; the env maps cameras to camera{i} positionally and the prompt labels them by position. (2) obj_registries must be ['objaverse', 'lightwheel'] -- OpenTau's ('lightwheel',) default changes object sampling, and a scene generated at the same reset seed then differs from the reference's (measured: the robot's base_position moves ~16 cm). The objaverse pack is ~30 GB; without it the numbers are not comparable to the leaderboard. (3) Set eval.seed_list to the reference's per-episode seeds (7 + target50_index*50 + episode) so both harnesses roll identical scenes.",
        "tags": [],
        "group": null,
        "job_type": null,
        "mode": null,
        "on_resume": "fork",
        "disable_artifact": false
    }
}
